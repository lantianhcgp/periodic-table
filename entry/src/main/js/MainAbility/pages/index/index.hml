<div class="page">
  <div class="loading" if="{{!ready}}" @click="measure"><text class="loading-t">{{error}}</text></div>
  <div class="body" if="{{ready}}" style="width: {{w}}px; height: {{h}}px;">
    <div class="head" style="width: {{headerW}}px; height: {{headerH}}px;">
      <text class="title" style="width: {{titleW}}px; height: {{captionH}}px; font-size: {{titleFont}}px;">&#x5143;&#x7D20;&#x5468;&#x671F;&#x8868;</text>
      <text class="badge" style="width: {{badgeW}}px; height: {{textH}}px; font-size: {{smallFont}}px;">118 &#x5143;&#x7D20;</text>
    </div>
    <stack class="viewport" style="width: {{viewportW}}px; height: {{viewportH}}px;" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd" @touchcancel="touchCancel" @click="tap">
      <slider class="crown-proxy" ref="panCrown" min="0" max="100" value="{{crownValue}}" @change="listenCrown"></slider>
      <image class="atlas" src="/common/periodic_table_atlas.png" style="width: {{atlasW}}px; height: {{atlasH}}px; left: {{imageLeft}}px; top: {{imageTop}}px;"></image>
    </stack>
  </div>
</div>
