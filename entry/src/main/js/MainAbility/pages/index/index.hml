<div class="page">
  <div class="head">
    <text class="head-t">{{ title }}</text>
    <text class="head-b">{{ badge }} · {{ zoomLabel }}</text>
  </div>

  <list class="table-list" ref="tableList" style="height: {{ listH }}px;">
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r0 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r1 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r2 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r3 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r4 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r5 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="row" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r6 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="frow" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r7 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
    <list-item class="frow2" style="height: {{ ch }}px;">
      <div class="cell" for="{{ c in r8 }}" style="width: {{ cw }}px; height: {{ ch }}px; background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text style="color: {{ c.color }}; font-size: {{ c.fs }}px;">{{ c.sym }}</text>
      </div>
    </list-item>
  </list>

  <div class="legend">
    <text class="legend-t">{{ hint }}</text>
  </div>

  <div class="zoombar">
    <div class="zb" @click="panLeft"><text class="zb-t">◀</text></div>
    <div class="zb" @click="zoomOut"><text class="zb-t">－</text></div>
    <div class="zb zbl"><text class="zb-l">{{ zoomLabel }}</text></div>
    <div class="zb" @click="zoomIn"><text class="zb-t">＋</text></div>
    <div class="zb" @click="panRight"><text class="zb-t">▶</text></div>
  </div>
</div>