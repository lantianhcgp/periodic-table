<div class="page">
  <div class="head">
    <text class="head-t">{{ title }}</text>
    <text class="head-b">{{ badge }}</text>
  </div>
  <div class="grid">
    <div class="row">
      <div class="cell" for="{{ c in r0 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r1 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r2 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r3 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r4 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r5 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="row">
      <div class="cell" for="{{ c in r6 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="frow">
      <div class="cell" for="{{ c in r7 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
    <div class="frow2">
      <div class="cell" for="{{ c in r8 }}" style="background-color: {{ c.bg }};" @click="onOpenElement(c.z)">
        <text class="sym" if="{{ c.z > 0 }}" style="color: {{ c.color }};">{{ c.sym }}</text>
        <text class="ph" if="{{ c.z === 0 && c.sym !== '' }}" style="color: {{ c.color }};">{{ c.sym }}</text>
      </div>
    </div>
  </div>
  <text class="hint">{{ hint }}</text>
  <div class="legend">
    <div class="lg" for="{{ (li, l) in legend }}">
      <div class="lgdot" style="background-color: {{ l[1] }};"></div>
      <text class="lgtxt">{{ l[0] }}</text>
    </div>
  </div>
</div>
